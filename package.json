{
  "name": "avtar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && pnpm --filter @avtar/agent-provider build && pnpm --filter @avtar/agent-consumer build && pnpm --filter @avtar/web build",
    "clean": "tsc -b --clean",
    "test": "tsc -b && pnpm -r --no-bail test",
    "test:e2e": "pnpm --filter @avtar/agent-core test:e2e",
    "generate:abi": "pnpm --filter @avtar/onchain-setup generate:abi",
    "demo": "pnpm --filter @avtar/agent-consumer demo",
    "serve:provider": "pnpm --filter @avtar/agent-provider serve",
    "serve:consumer": "pnpm --filter @avtar/agent-consumer serve",
    "serve:web": "pnpm --filter @avtar/web dev"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  }
}
