# slate-base — settlement on Base.
#
# Copy to `.env`; it is gitignored. Shell env always wins.
#
# MOCK vs REAL: the master switch is EVM_PRIVATE_KEY. Unset, `slateClientFromEnv`
# returns null and callers fall back to a mock — everything below can stay blank.
# Set it and the deployed addresses become REQUIRED; a missing one throws at
# startup rather than surfacing later as an unexplained revert.
# Force mock even when the key is set: SLATE_MOCK=true

# ── signing ──────────────────────────────────────────────────────────────────
# 32-byte hex key. Funds the escrow AND submits settlement — the consumer pays
# for everything, including gas. The provider never signs.
# For anvil, use its first account:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EVM_PRIVATE_KEY=

# ── chain ────────────────────────────────────────────────────────────────────
# 8453 (Base), 84532 (Base Sepolia, default), 31337 (local anvil).
# The default is Base Sepolia: a testnet with real USDC and a facilitator.
# BASE_CHAIN_ID=84532
# Defaults to the chain's public RPC, or http://127.0.0.1:8545 on anvil.
# BASE_RPC_URL=

# ── deployed contracts ───────────────────────────────────────────────────────
# Printed by `forge script script/Deploy.s.sol`. REQUIRED once the key is set.
SLATE_ESCROW_ADDRESS=
SLATE_REGISTRY_ADDRESS=

# ERC-20 settled in. Defaults to Circle USDC for the chain — 0x036CbD…CF7e on
# Base Sepolia, 0x833589…2913 on Base. Set it only to settle in something else,
# or on anvil, where the token is deployed per-run. Must be whitelisted on the
# escrow, or `openChannel` refuses before spending gas. Also read by the deploy
# script, which whitelists it.
# SETTLEMENT_TOKEN=

# The provider's PAYOUT address — bound into the proof as the payee; the escrow
# pays exactly this. Public address only. Defaults to the depositor.
# PROVIDER_ADDRESS=

# ── deploy only ──────────────────────────────────────────────────────────────
# Escrow owner after deployment (whitelisting is owner-only). Defaults to the
# deployer, which is what you want locally.
# ESCROW_OWNER=

# ── x402 terms (provider side) ───────────────────────────────────────────────
# What the provider advertises in its 402. The proof binds the payee and asset,
# and the escrow only pays whitelisted tokens, so these must agree with the
# contracts above — they are validated as addresses, not trusted as strings.

# Where the provider is paid. REQUIRED to advertise terms; there is no safe
# default, an unset payee would advertise somewhere the escrow will not pay.
X402_PAY_TO=

# ERC-20 accepted for payment. Defaults to USDC for the chain, same as
# SETTLEMENT_TOKEN.
# X402_ASSET=

# Per-unit price in the token's decimal units. Default: 0.0001.
# RATE=0.0001

# Ceiling advertised in the terms, in base units. Default: 100000000.
# X402_MAX_AMOUNT=100000000

# Defaults to the x402 name for BASE_CHAIN_ID: base, or base-sepolia. Anvil has
# no facilitator, so local runs must stay on the mock verifier.
# X402_NETWORK=base-sepolia

# Payment verification.
#   true  (default) → MockPaymentVerifier: accepts any well-formed header for
#                     the advertised network.
#   false           → FacilitatorPaymentVerifier: POSTs to the facilitator.
# MOCK_X402=true
# X402_FACILITATOR_URL=https://x402.org/facilitator

# ── demo agents ──────────────────────────────────────────────────────────────
# Provider HTTP server (:4021) and consumer chat server (:4022).
# PORT=4021
# CONSUMER_PORT=4022
# PROVIDER_URL=http://localhost:4021
# CORS_ORIGIN=http://localhost:3000
# ESCROW=0.01
# X402_PAYMENT_SIGNATURE=demo-payment
# OPENAI_API_KEY=
