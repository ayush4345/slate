# slate-base — settlement on Base.
#
# Copy to `.env`; it is gitignored. Shell env always wins.
#
# MOCK vs REAL: the master switch is EVM_PRIVATE_KEY. Unset, `slateClientFromEnv`
# returns null and callers fall back to a mock — everything below can stay blank.
# Set it and the deployed addresses become REQUIRED; a missing one throws at
# startup rather than surfacing later as an unexplained revert.
# Force mock even when the key is set: SLATE_MOCK=true

# ── signing ──────────────────────────────────────────────────────────────────
# 32-byte hex key. Funds the escrow AND submits settlement — the consumer pays
# for everything, including gas. The provider never signs.
# For anvil, use its first account:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
EVM_PRIVATE_KEY=

# ── chain ────────────────────────────────────────────────────────────────────
# 8453 (Base), 84532 (Base Sepolia, default), 31337 (local anvil).
# BASE_CHAIN_ID=84532
# Defaults to the chain's public RPC, or http://127.0.0.1:8545 on anvil.
# BASE_RPC_URL=

# ── deployed contracts ───────────────────────────────────────────────────────
# Printed by `forge script script/Deploy.s.sol`. REQUIRED once the key is set.
SLATE_ESCROW_ADDRESS=
SLATE_REGISTRY_ADDRESS=

# ERC-20 settled in. Must be whitelisted on the escrow, or `openChannel` refuses
# before spending gas. Base Sepolia USDC: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Also read by the deploy script, which whitelists it.
SETTLEMENT_TOKEN=

# The provider's PAYOUT address — bound into the proof as the payee; the escrow
# pays exactly this. Public address only. Defaults to the depositor.
# PROVIDER_ADDRESS=

# ── deploy only ──────────────────────────────────────────────────────────────
# Escrow owner after deployment (whitelisting is owner-only). Defaults to the
# deployer, which is what you want locally.
# ESCROW_OWNER=

# ── demo agents ──────────────────────────────────────────────────────────────
# Provider HTTP server (:4021) and consumer chat server (:4022).
# PORT=4021
# CONSUMER_PORT=4022
# PROVIDER_URL=http://localhost:4021
# CORS_ORIGIN=http://localhost:3000
# RATE=0.0001
# ESCROW=0.01
# MOCK_X402=true
# X402_PAYMENT_SIGNATURE=demo-payment
# OPENAI_API_KEY=
